# SMTP credentials used by src/app/api/contact/route.ts to send contact-form
# submissions (via nodemailer — no third-party mail API). Without these set,
# the /api/contact route returns a clear 500 error instead of crashing.
#
# These are the credentials of a real mailbox that can send mail: most mail
# hosts (cPanel, Google Workspace, Fastmail, ...) expose SMTP for the mailboxes
# they already host. If pragmaticlabs.ai already has mail hosting, this is
# likely a mailbox on that same server (check the host's control panel for the
# SMTP hostname and port) — a hosting account and an SMTP account are usually
# the same login.
SMTP_HOST=
# 465 = implicit TLS (the connection is encrypted from the first byte).
# 587 = STARTTLS (starts plain, then upgrades) — also the common default.
# Whichever port you use, secure mode is derived from it in code; there is no
# separate on/off switch to set here.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Who receives contact-form submissions. Comma-separated; whitespace around
# each address is ignored, malformed entries are dropped, duplicates collapse.
# All recipients go on the To: line, and Reply-To is the person who filled in
# the form, so replying from any of these inboxes reaches them directly.
CONTACT_TO_EMAIL=
# The "From" address on outgoing mail. Many SMTP servers require this to match
# SMTP_USER (or at least share its domain) or they silently rewrite it —
# check with whoever hosts the mailbox if sends succeed but arrive from the
# wrong address. Falls back to SMTP_USER if left blank.
CONTACT_FROM_EMAIL=Pragmatic Labs AI <hello@pragmaticlabs.ai>
